{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin') && (auth.uid !== $uid || (newData.child('rol').val() === 'admin' && newData.child('activo').val() === true))",
        ".validate": "newData.hasChildren(['rol', 'activo'])",
        "rol": {
          ".validate": "newData.isString() && newData.val().matches(/^(admin|gestor|auditor|lector)$/)"
        },
        "activo": {
          ".validate": "newData.isBoolean()"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "actualizado": {
          ".validate": "newData.isNumber()"
        },
        "por": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "solicitudes": {
      ".read": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid && !data.exists() && newData.exists()) || ((auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin') && !newData.exists())",
        ".validate": "newData.hasChildren(['email', 'creada'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120 && newData.val() === auth.token.email"
        },
        "creada": {
          ".validate": "newData.isNumber()"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "perfiles": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      "$uid": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('rol').val() === 'admin')",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "cargo": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "telefono": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "avatarUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\//)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "auditorias": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".indexOn": [
        "uid"
      ],
      "$id": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor')) && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || data.child('uid').val() === auth.uid || (!data.exists() && newData.child('uid').val() === auth.uid))",
        ".validate": "$id.matches(/^[A-Za-z0-9_-]{4,64}$/) && newData.hasChildren(['uid', 'institucion', 'estado'])",
        "uid": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "institucion": {
          ".validate": "newData.isString() && newData.val().matches(/^(foca|viu)$/)"
        },
        "estado": {
          ".validate": "newData.isString() && newData.val().matches(/^(en-progreso|completada|pendiente)$/)"
        },
        "porcentaje": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "sede": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "fecha": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "auditorNombre": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "auditorCargo": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "deletedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "auditorias_pi": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".indexOn": [
        "uid"
      ],
      "$id": {
        ".read": "!data.exists() || (data.child('tipo').val() === 'paciente-incognito' && data.child('estado').val() !== 'completada' && !data.child('deletedAt').exists())",
        ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor')) && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || data.child('uid').val() === auth.uid || (!data.exists() && newData.child('uid').val() === auth.uid))) || (newData.exists() && newData.child('tipo').val() === 'paciente-incognito' && (!data.exists() || (data.child('tipo').val() === 'paciente-incognito' && data.child('estado').val() !== 'completada' && !data.child('deletedAt').exists())) && newData.child('uid').val() === data.child('uid').val() && newData.child('email').val() === data.child('email').val() && newData.child('auditorNombre').val() === data.child('auditorNombre').val() && !newData.child('deletedAt').exists())",
        ".validate": "$id.matches(/^[A-Za-z0-9_-]{4,64}$/) && newData.hasChildren(['tipo', 'institucion', 'estado'])",
        "tipo": {
          ".validate": "newData.val() === 'paciente-incognito'"
        },
        "origen": {
          ".validate": "newData.val() === 'qr-paciente'"
        },
        "uid": {
          ".validate": "newData.val() === data.val() || (!data.exists() && auth != null && newData.val() === auth.uid)"
        },
        "horaInicio": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "horaFin": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "clasificacion": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "institucion": {
          ".validate": "newData.isString() && newData.val().matches(/^(foca|viu)$/)"
        },
        "estado": {
          ".validate": "newData.isString() && newData.val().matches(/^(en-progreso|completada|pendiente)$/)"
        },
        "porcentaje": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "sede": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "fecha": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "auditorNombre": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "auditorCargo": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "deletedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "gdoc": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      "admins": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin')",
        "$uid": {
          ".validate": "newData.val() === true"
        }
      },
      "$otro": {
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor'))"
      }
    },
    "indicadores": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor'))"
    },
    "indicadores_seguimiento": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor'))"
    },
    "indicadores_informes": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor'))"
    },
    "autoevaluacionISO": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'gestor' || root.child('usuarios').child(auth.uid).child('rol').val() === 'auditor'))"
    }
  }
}